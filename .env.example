# ============================================================
#  Environment Variables — Daily Sales & Revenue Report
#  Copy this file to .env and fill in your SMTP credentials.
#  NEVER commit the .env file to version control.
# ============================================================

# SMTP Configuration (Google Workspace / Gmail / Outlook)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@yourcompany.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@yourcompany.com

# Server
PORT=3000

# Metabase Live D-o-D Funnel Data Feed
METABASE_CSV_URL=https://your-metabase-url/public/question/your-question-id.csv

# Google Sheets Spreadsheet ID
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SHEET_NAME=Sheet1
